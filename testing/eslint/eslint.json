{
  "env": {
    "browser": true,
    "jquery": true
  },
  "globals": {
    // All intended global variables in ExamSys should be listed here.
    "ROGO": false,
    // Require JS globals
    "requirejs": false,
    "define": false,
    // Globals we create in RequireJS
    "tinyMCE": false,
    "MathJax": false,
    // JS types we use but ESLint seems to not like.
    "ArrayBuffer": false,
    "DataView": false,
    "Int32Array": false,
    "Uint8Array": false
  },
  // For a list of rules see: http://eslint.org/docs/rules/
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": "error",
    "no-prototype-builtins": "warn"
  }
}
