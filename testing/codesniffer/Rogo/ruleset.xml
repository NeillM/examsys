<?xml version="1.0"?>
<ruleset name="Rogo">
    <description>The Rogō coding standard</description>
    <!-- Skip 3rd party code-->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/plugins/texteditor/plugin_tinymce3_texteditor/mee/mee/tools/include/*</exclude-pattern>
    <exclude-pattern>*/plugins/questions/enhancedcalc/rserve/*</exclude-pattern>
    <exclude-pattern>*/LTI/classes/*</exclude-pattern>
    <!-- Skip config file-->
    <exclude-pattern>config/config.inc.php</exclude-pattern>
    <!-- Only look at php files -->
    <arg name="extensions" value="php,inc" />
    <!-- Rules.
    We follow PSR-12 with some caveats due to old code base-->
    <rule ref="PSR12">
        <!-- Namespaces and classes DO NOT follow PSR-0 -->
        <exclude name="PSR1.Classes.ClassDeclaration"/>
    </rule>
    <!-- As we support PHP 7.2 as a minimum constant visibility should error -->
    <rule ref="PSR12.Properties.ConstantVisibility">
        <type>error</type>
    </rule>
    <!-- Only use double quotes if necessary-->
    <rule ref="Squiz.Strings.DoubleQuoteUsage"/>
    <!-- Old code has a lot of double quotes containing vars so just warn for now -->
    <rule ref="Squiz.Strings.DoubleQuoteUsage.ContainsVar">
        <type>warning</type>
    </rule>
    <!-- Perl style comments not allowed -->
    <rule ref="PEAR.Commenting.InlineComment"/>
    <!-- Warning if php doc missing from class -->
    <rule ref="PEAR.Commenting.ClassComment.Missing">
        <type>warning</type>
    </rule>
    <!-- Warning if php doc missing from function -->
    <rule ref="PEAR.Commenting.FunctionComment.Missing">
        <type>warning</type>
    </rule>
    <!-- Warning if php doc missing from file -->
    <rule ref="PEAR.Commenting.FileComment.Missing">
        <type>warning</type>
    </rule>
    <!-- Warning if commented out code detected - set by default at 35% valid code-->
    <rule ref="Squiz.PHP.CommentedOutCode"/>
    <!-- Rogo specific coding standards warning for now as lots to fix -->
    <rule ref="Rogo.Operators.ValidBooleanOperators">
        <type>warning</type>
    </rule>
    <rule ref="Rogo.File.Boilerplate">
        <type>warning</type>
    </rule>
    <rule ref="Rogo.PHP.Param">
        <type>warning</type>
    </rule>
</ruleset>
